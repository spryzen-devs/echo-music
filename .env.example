# Supabase Configuration for Echo Music
# Obtain these from your Supabase Project Dashboard under Project Settings -> API.
# In Expo, only environment variables prefixed with EXPO_PUBLIC_ are exposed to client JavaScript.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Security Notice:
# - NEVER put service_role secret keys, master keys, or database passwords here.
# - The anon key is safe for client applications when Row Level Security (RLS) is enabled.
# - Cloudflare R2 storage credentials will be configured securely in future phases.
